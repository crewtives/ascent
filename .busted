-- Ascent - busted configuration.
--
-- The suite runs on LuaJIT, which has the Lua 5.1 runtime semantics of the client.
-- It does not check syntax: LuaJIT accepts `goto`, labels and extensions that the
-- client rejects at load time. busted is installed in the Lua 5.1 rock tree, so its
-- launcher runs LuaJIT; harness_spec.lua asserts _VERSION in case it does not.
return {
  default = {
    ROOT = { "Ascent/test" },
    pattern = "_spec%.lua$",
    helper = "Ascent/test/helper.lua",
    verbose = true,
  },
}
