# Ascent - what public text may not contain, one rule per line.
#
# Format: <category><TAB><extended regular expression>. Read by ./dev.sh lint
# (check_public_text) and by .githooks/commit-msg. Every rule has cases in
# tools/public-text.cases that the lint runs before it reads the tree.
#
# planning path matches references to documents, not the folder name on its
# own: .pkgmeta and .luacheckrc name it to keep it out of a zip and out of
# the analysis, which is configuration rather than a pointer for a reader.

decision id	\bD[0-9]{1,3}\b
task ref	\b([Tt]asks?|[Gg]roups?|[Ss]pikes?) [0-9]+[a-z]?(\.[0-9]+)?\b
task ref	`[0-9]{1,2}[a-z]?\.[0-9]{1,2}`
change name	\b(add|fix)-ascent-[a-z0-9-]+
planning path	openspec/(changes|specs)|\b(proposal|design|tasks)\.md\b|\b(spec delta|delta spec)\b
assistant	\bClaude\b|claude\.(ai|com)|anthropic\.com
