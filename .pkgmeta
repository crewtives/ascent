# Ascent - the packaging manifest the ecosystem looks for.
#
# This repository does not use it: ./dev.sh package builds the zip and
# tools/curseforge-upload.sh uploads it. It is kept safe for anyone who runs the
# BigWigs packager over a checkout, so that nothing but the addon ends up in a zip.
#
# The packager's @project-version@ stamps a development build as v0.1.0-5-gabc1234,
# which semver orders before 0.1.0, so the update check would ask for a version
# already behind the build. The addon sits in Ascent/, not at the root the packager
# assumes: the worst case is a folder nested one level too deep.

package-as: Ascent

# The changelog is written by hand, and the in-game changelog is generated from it.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# Everything that is repository, not addon. Ascent/test matters most: it sits
# inside the packaged folder.
ignore:
    - Ascent/test
    - openspec
    - tools
    - press
    - generated-images
    - dist
    - dev.sh
    - .busted
    - .luacheckrc
    - .luacheckcache
    - .github
    - .claude
    - .gitignore
    - .pkgmeta
    - CLAUDE.md
    - README.md
    - LICENSE
    - CHANGELOG.md

# No second, library-free zip: the addon embeds no libraries.
enable-nolib-creation: no
